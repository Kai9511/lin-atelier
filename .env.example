# Copy this file to .env.local and fill in the values.
# Supabase: Project Settings → API (Project URL and the anon / publishable key).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# The public address of the site, used for SEO, sitemap and share previews.
# Locally: http://localhost:3000. On Vercel: your production URL or custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
